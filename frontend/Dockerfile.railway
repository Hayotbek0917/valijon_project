FROM oven/bun:1
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
# Bo'sh = brauzer corepos.up orqali proxy (/api -> backend). Cross-origin CORS kerak emas.
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN bun run build
EXPOSE 3000
CMD ["bun", "run", "start"]
